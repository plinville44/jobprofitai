# JobProfitAI — environment variables
#
# Copy to `.env` for local development and fill in real values.
# NEVER commit `.env` (it's in .gitignore) and never put real secrets here.
# This file lists variable NAMES ONLY, with notes on where each value comes from.
#
# Every variable below is server-side. None are prefixed NEXT_PUBLIC_, which
# means none of them are exposed to the browser — that is deliberate and
# should stay that way. Adding NEXT_PUBLIC_ to any secret here would ship it
# to every visitor.

# ─────────────────────────────────────────────────────────────────────────
# DATABASE (Neon Postgres)
# ─────────────────────────────────────────────────────────────────────────
# Neon → your project → Connection Details → pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────
# Absolute base URL, no trailing slash. Used for OAuth redirects, Stripe
# return URLs, referral links, email links, sitemap and canonical URLs.
# Local: http://localhost:3000   Production: https://jobprofitai.com
APP_URL="http://localhost:3000"

# Signs session cookies and the QuickBooks OAuth state token, and salts the
# contact-form IP hash. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts QuickBooks tokens and realm IDs at rest (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate: openssl rand -base64 32
#
# ⚠ Changing this in an environment that already has connections makes every
# stored token undecryptable — customers would have to reconnect QuickBooks.
TOKEN_ENCRYPTION_KEY=""

# Comma-separated email allowlist for the /dashboard/admin area.
# Unset means nobody is an admin, which is the correct default.
ADMIN_EMAILS=""

# ─────────────────────────────────────────────────────────────────────────
# QUICKBOOKS / INTUIT
# ─────────────────────────────────────────────────────────────────────────
# developer.intuit.com → your app → Keys & credentials.
# Development and Production have SEPARATE client IDs and secrets — they are
# not interchangeable, and a sandbox company will not authorize against
# production keys (or vice versa).
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""

# "sandbox" | "production" — selects both the API base URL and the OAuth
# discovery document, so it must match which key pair is above.
QBO_ENVIRONMENT="sandbox"

# Must EXACTLY match a Redirect URI registered in the Intuit app settings for
# the matching environment, including scheme, host and path. A mismatch fails
# the callback with an opaque error.
QBO_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"

# ─────────────────────────────────────────────────────────────────────────
# ANTHROPIC (profit insights + weekly digest narrative)
# ─────────────────────────────────────────────────────────────────────────
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────────────────────────────────
# resend.com → API Keys. Server-side only — never expose to the browser.
RESEND_API_KEY=""

# The verified sending identity. The domain must be verified in Resend
# (SPF/DKIM records added) or every send is rejected.
EMAIL_FROM="JobProfitAI <noreply@jobprofitai.com>"

# Where replies and support enquiries go. Used as the default Reply-To on
# every message, and shown throughout the product and marketing site.
SUPPORT_EMAIL="support@jobprofitai.com"

# Destination for marketing-site contact form submissions.
# Production value must be support@jobprofitai.com — never a personal inbox.
CONTACT_TO_EMAIL="support@jobprofitai.com"

# Optional: destination for in-app product feedback.
# Falls back to CONTACT_TO_EMAIL, then SUPPORT_EMAIL.
FEEDBACK_TO_EMAIL=""

# Legacy: subject/sender for the weekly digest. The digest now uses
# EMAIL_FROM; this remains only for backwards compatibility.
DIGEST_FROM_EMAIL=""

# DEVELOPMENT SAFEGUARD. When set, EVERY outbound email is redirected to this
# single address instead of real recipients, with the intended recipient
# prefixed into the subject. Set this in any preview environment pointed at a
# copy of production data. MUST be empty in production.
EMAIL_DEV_REDIRECT=""

# ─────────────────────────────────────────────────────────────────────────
# STRIPE
# ─────────────────────────────────────────────────────────────────────────
# Test mode keys start sk_test_ / whsec_ ; live mode keys start sk_live_.
# NEVER mix a live secret key with test-mode price IDs, or vice versa —
# checkout will fail with a confusing "no such price" error.
STRIPE_SECRET_KEY=""

# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Each endpoint (test and live) has its OWN signing secret.
STRIPE_WEBHOOK_SECRET=""

# Price IDs (price_...), NOT product IDs (prod_...).
# Profit Intelligence — $149/month recurring
STRIPE_PRICE_PROFIT_INTELLIGENCE_MONTHLY=""
# Profit Intelligence Pro — $299/month recurring
STRIPE_PRICE_PROFIT_INTELLIGENCE_PRO_MONTHLY=""

# ─────────────────────────────────────────────────────────────────────────
# SCHEDULED JOBS (Vercel Cron)
# ─────────────────────────────────────────────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
# REQUIRED in production: the cron endpoints send customer email, issue
# account credits and spend Anthropic tokens, and they reject every request
# when this is missing in production rather than becoming publicly callable.
# Generate: openssl rand -base64 32
CRON_SECRET=""
