// JobMarginAI data model
// Core idea: a User owns one or more QuickBooksConnections (one per QBO company file).
// Each connection syncs Jobs, which accumulate CostEntries and Estimates.
// A WeeklyDigest is generated per connection per week from that data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connections   QuickBooksConnection[]
  subscription  Subscription?

  // --- Growth systems (trial, referrals, partners, lifecycle email) ---
  // Every relation here is optional or one-to-many, so adding them doesn't
  // change a single existing User row. The ReferralCode in particular is
  // created lazily (first time the user opens their referral dashboard, see
  // src/lib/referrals.ts) rather than at signup, so no backfill is needed.
  trialFeedback     TrialFeedback?
  referralCode      ReferralCode?
  referralsMade     Referral[]       @relation("ReferrerUser")
  referralReceived  Referral?        @relation("ReferredUser")
  referralRewards   ReferralReward[]
  partner           Partner?
  emailEvents       EmailEvent[]
  passwordResets    PasswordResetToken[]
}

// A single-use, time-limited password reset.
//
// The raw token is NEVER stored. Only its SHA-256 hash lands here, so a
// leaked database snapshot cannot be used to take over accounts - an
// attacker holding these rows still has nothing they can put in a reset
// link. The raw value exists exactly twice: in the email we send, and in
// the URL the customer clicks.
//
// `tokenHash` is unique so a token can only ever identify one row, and
// `usedAt` makes the reset single-use: consuming it stamps a time, and the
// same link stops working immediately afterwards.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?

  createdAt   DateTime  @default(now())

  // Rate limiting counts recent rows per user, so this index is what keeps
  // "have they asked five times in the last hour?" cheap.
  @@index([userId, createdAt])
  @@index([expiresAt])
}

// One per connected QuickBooks Online company file ("realm").
// A user could plausibly run this for more than one company (e.g. an accountant),
// so this is 1-to-many rather than 1-to-1.
model QuickBooksConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The QuickBooks company ("realm") ID, encrypted at rest (AES-256-GCM,
  // see src/lib/crypto.ts) per Intuit's security requirements. Since the
  // encrypted value isn't queryable (random IV each time), realmIdHash - a
  // deterministic SHA-256 hash - is what "which company is this" lookups
  // actually use. Decrypt `realmId` only when the real ID is needed (e.g.
  // to call the QuickBooks API).
  realmId           String    @db.Text
  realmIdHash       String    @unique
  companyName       String?

  // OAuth tokens - encrypted at the application layer before write, see src/lib/crypto.ts
  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  accessTokenExpiresAt   DateTime
  refreshTokenExpiresAt  DateTime

  environment       String    @default("sandbox") // "sandbox" | "production"
  costTrackingMode  String    @default("unknown")  // "projects" | "classes" | "unknown" - discovered on first sync

  // Company-wide default target job margin (%). Per-category overrides live in
  // MarginTarget below; this is the fallback when no category-specific target
  // exists. Nullable until the user sets one in Settings - no target means
  // "below target" comparisons simply don't run yet.
  targetMarginPct   Decimal?  @db.Decimal(5, 2)

  // Overhead allocation (powers "Fully Loaded Profit" - off by default per spec;
  // Fully Loaded Profit is only ever computed/shown when overheadEnabled=true
  // AND overheadMethod/overheadValue are both set).
  overheadEnabled   Boolean   @default(false)
  overheadMethod    String?   // "pct_of_revenue" | "pct_of_direct_cost"
  overheadValue     Decimal?  @db.Decimal(7, 4)

  // Weekly email preferences. Defaults to Monday 8am in the connection owner's
  // timezone per spec, until they configure otherwise in Settings.
  emailEnabled      Boolean   @default(true)
  emailRecipients   String[]  @default([])
  emailDay          Int       @default(1) // 0=Sun..6=Sat
  emailHour         Int       @default(8) // 0-23, local to emailTimezone
  emailTimezone     String    @default("America/New_York")

  // Sync observability (see also the SyncRun history table below - these are
  // just "latest" fields for fast dashboard reads without a join).
  lastSyncStatus            String?   // "success" | "error" | "in_progress"
  lastSyncError             String?
  lastSyncAttemptAt         DateTime?
  lastSyncEntitiesUpdated   Json?
  lastFullSyncAt            DateTime? // last time a full (non-incremental) sync ran

  connectedAt       DateTime  @default(now())
  disconnectedAt    DateTime?
  lastSyncedAt      DateTime?

  jobs              Job[]
  digests           WeeklyDigest[]
  marginTargets     MarginTarget[]
  syncRuns          SyncRun[]
  analysisRuns      AnalysisRun[]
  profitInsights    ProfitInsight[]
  feedback          Feedback[]

  @@index([userId])
}

// Per-category override of the connection's default target margin (e.g.
// "roofing jobs should target 22%, everything else uses the company default").
// category = null is reserved/unused here - the connection-wide default lives
// on QuickBooksConnection.targetMarginPct directly, not as a row here, to avoid
// a chicken-and-egg lookup on every request.
model MarginTarget {
  id            String    @id @default(cuid())
  connectionId  String
  connection    QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  category      String
  targetPct     Decimal   @db.Decimal(5, 2)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([connectionId, category])
  @@index([connectionId])
}

// History of sync attempts, for the observability the App Assessment
// Questionnaire and the product spec both ask for (last attempted/successful
// sync, status, errors, entities updated) - not just a "last synced at"
// snapshot, an actual log to look back on if something goes wrong.
model SyncRun {
  id                String    @id @default(cuid())
  connectionId      String
  connection        QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  status            String    // "in_progress" | "success" | "error"
  mode              String    // "full" | "incremental"
  entitiesUpdated   Json?     // e.g. { jobs: 3, purchases: 12, bills: 4, timeActivities: 9, invoices: 8, estimates: 2 }
  errorMessage      String?

  @@index([connectionId])
}

// One row per time the dashboard/intelligence numbers were (re)computed.
// Used to answer "has financial data changed since the last analysis" by
// comparing dataSnapshotAt to the connection's current lastSyncedAt, so
// /api/analysis/refresh doesn't re-run the AI layer unless something actually
// changed.
model AnalysisRun {
  id              String    @id @default(cuid())
  connectionId    String
  connection      QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  generatedAt     DateTime  @default(now())
  dataSnapshotAt  DateTime  // the connection.lastSyncedAt this analysis was computed from
  kind            String    // "dashboard" | "intelligence"

  @@index([connectionId, kind])
}

// A persisted Profit Intelligence finding (Finding/Evidence/Impact/Action/
// Confidence). sourceJobIds makes every finding traceable back to the jobs
// that produced it, per the "why am I seeing this" explainability requirement.
// confidence is assigned deterministically by app code before storage (based
// on sample size), never by the model's own self-assessment.
model ProfitInsight {
  id                String    @id @default(cuid())
  connectionId      String
  connection        QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  generatedAt       DateTime  @default(now())
  dimension         String    // "job_category" | "customer" | "cost_category" | ...
  finding           String    @db.Text
  evidence          String    @db.Text
  financialImpact   Decimal?  @db.Decimal(12, 2)
  recommendedAction String    @db.Text
  confidence        String    // "high" | "medium" | "low"
  status            String    @default("active") // "active" | "dismissed"
  sourceJobIds      String[]  @default([])

  @@index([connectionId, status])
}

// "Suggest an Improvement" submissions. Stored first (always succeeds even if
// the notification email fails) - the spec is explicit that feedback must not
// depend on email alone.
model Feedback {
  id            String    @id @default(cuid())
  userId        String
  userEmail     String
  connectionId  String?
  connection    QuickBooksConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  plan          String

  category      String    // "Feature Request" | "Report" | "Integration" | "Bug/Problem" | "Other"
  message       String    @db.Text
  page          String
  screenshotUrl String?   // not wired up yet - see plan's known-limitations note (needs blob storage)

  createdAt     DateTime  @default(now())

  @@index([userId])
}

// A "job" maps to a QuickBooks Project (sub-customer) or a Class, depending on
// how the contractor tracks cost. We normalize both into this one model.
model Job {
  id                String    @id @default(cuid())
  connectionId      String
  connection        QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  qboId             String    // QBO Project/Customer/Class ID
  // The parent Customer's QBO id, when this Job is a Project (sub-customer).
  // Captured so expenses tagged to the parent customer instead of the project
  // itself - common when a bookkeeper enters a Bill/Purchase without drilling
  // into the specific Project - can still be attributed to this job when
  // it's the parent's only job. See CostEntry.attributionMethod.
  parentQboId       String?
  name              String
  customerName      String?
  status            String    @default("open") // "open" | "closed"

  estimatedRevenue  Decimal?  @db.Decimal(12, 2) // synced from QBO Estimate entity when available
  estimatedCost     Decimal?  @db.Decimal(12, 2) // manual only - QBO's public API doesn't expose internal cost budgets, see plan §6
  estimatedCostSource String  @default("manual")  // always "manual" today; field exists so the UI/tooltips are honest about provenance rather than implying it came from QuickBooks

  // Manually-set job type (e.g. "roofing", "remodel"), used for cross-job
  // benchmarking in Profit Intelligence. QBO has no reliable field for this
  // (see plan §6) so it's a simple optional in-app tag, not synced.
  category          String?

  startDate         DateTime?
  endDate           DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  costEntries       CostEntry[]
  invoices          InvoiceSummary[]

  @@unique([connectionId, qboId])
  @@index([connectionId])
}

// Raw actual-cost line items pulled from QBO: bills, expenses, time activities,
// purchase orders. Kept granular so the profitability engine can break down by category.
model CostEntry {
  id            String    @id @default(cuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  qboSourceType String    // "Bill" | "Expense" | "TimeActivity" | "Purchase"
  qboSourceId   String

  category      String    // "labor" | "materials" | "subcontractor" | "equipment" | "overhead" | "other"
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  txnDate       DateTime

  // "direct" = the transaction's own CustomerRef matched this job's QBO id
  // exactly. "parent_customer_fallback" = the transaction was tagged to this
  // job's PARENT customer instead of the job/project itself, and this was
  // the parent's only job, so it was attributed here - a judgment call worth
  // being able to spot and double-check, not a fabricated number (the dollar
  // amount is always the real transaction amount either way).
  attributionMethod String @default("direct")

  createdAt     DateTime  @default(now())

  @@index([jobId])
  @@index([jobId, category])
}

// Actual revenue recognized against a job, from QBO invoices.
model InvoiceSummary {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  qboInvoiceId String
  amount       Decimal  @db.Decimal(12, 2)
  status       String   // "paid" | "open" | "overdue"
  txnDate      DateTime

  @@index([jobId])
}

// One generated digest per connection per week. `metrics` holds the computed
// profitability numbers (see src/lib/profitability.ts); `narrative` is the
// AI-written summary built strictly from `metrics` (see src/lib/digest.ts).
model WeeklyDigest {
  id             String    @id @default(cuid())
  connectionId   String
  connection     QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  weekStarting   DateTime
  metrics        Json      // structured profitability data the narrative is grounded in
  narrative      String    @db.Text
  // "narrative" = Claude-written digest (normal case). "data_health" = the
  // AI narrative was skipped entirely and `narrative` holds a deterministic,
  // plain-text explanation of what's missing instead - used when company-wide
  // Data Confidence is too low to trust an AI-written take on profitability
  // (see src/lib/digest.ts). Never AI-written when kind = "data_health".
  kind           String    @default("narrative")
  emailedAt      DateTime?

  createdAt      DateTime  @default(now())

  @@unique([connectionId, weekStarting])
  @@index([connectionId])
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?

  // Mirrors Stripe's own subscription status while a paid subscription
  // exists, plus two states Stripe has no concept of: "trialing" (our own
  // card-free 14-day trial, which is NOT a Stripe trial - no Stripe object
  // exists until they subscribe) and "trial_expired". Stripe remains the
  // source of truth for anything paid; this column exists so entitlement
  // checks don't have to call Stripe on every request.
  status                String    @default("trialing")
  // "trialing" | "trial_expired" | "active" | "past_due" | "canceled" | "incomplete" | "unpaid"

  // Entitlement tier - read exclusively through src/lib/entitlements.ts,
  // never checked directly elsewhere in the app.
  //   "profit_intelligence"     = $149/mo  (Profit Intelligence)
  //   "profit_intelligence_pro" = $299/mo  (Profit Intelligence Pro)
  //   "profit_monitor"          = legacy pre-launch tier, no longer sold;
  //                               mapped for entitlement purposes only.
  // Trialing accounts get full Profit Intelligence feature access without a
  // paid plan - that's what `status` is for. `plan` describes what they'd be
  // entitled to; `status` decides whether the entitlement is currently live.
  plan                  String    @default("profit_intelligence")

  // --- Trial lifecycle (server-side source of truth; never trust client dates) ---
  trialStartedAt        DateTime  @default(now())
  trialEndsAt           DateTime?

  // Trial "activation" = connected QuickBooks AND generated a first analysis.
  // Both timestamps are recorded independently so we can tell a user who
  // connected but never ran anything (needs a nudge email) apart from one
  // who never connected at all (needs a different nudge).
  quickbooksConnectedAt DateTime?
  firstAnalysisAt       DateTime?
  activatedAt           DateTime?

  // The one-time +14 day feedback extension. `trialExtendedAt` is the audit
  // trail; TrialFeedback.userId being @unique is what actually makes the
  // extension unrepeatable at the database level.
  trialExtendedAt       DateTime?

  // --- Paid lifecycle ---
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?
  // First time this account ever had a subscription invoice paid. Drives the
  // referral program's "paid for 30 days" qualification clock.
  firstPaidAt           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([trialEndsAt])
}

// ─────────────────────────────────────────────────────────────────────────
// GROWTH SYSTEMS
// Billing idempotency, trial extension, referrals, partners, lifecycle email.
// Everything below is new and additive - no existing table is modified
// destructively, so `prisma db push` applies it without data loss.
// ─────────────────────────────────────────────────────────────────────────

// Every Stripe webhook event we've already finished processing. The Stripe
// event id is the primary key, so a retried delivery of the same event hits
// a unique-constraint violation on insert and is skipped rather than
// re-applied. This is the single mechanism that stops retries from
// double-issuing referral credits, partner commissions or emails - see
// src/lib/stripe/webhookHandlers.ts, which inserts this row inside the same
// transaction as the side effects it guards.
model StripeEvent {
  id          String   @id // Stripe's own `evt_...` id
  type        String
  apiVersion  String?
  processedAt DateTime @default(now())

  @@index([type])
}

// Send-once ledger for every lifecycle email. `dedupeKey` encodes the
// user + email type + the specific lifecycle instant it belongs to (e.g.
// "trial_ending_soon:<userId>:<trialEndsAt ISO>"), so a cron job that runs
// every hour, or is retried, can call sendLifecycleEmail() freely and the
// unique constraint guarantees exactly one send. See src/lib/email/send.ts.
model EmailEvent {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailType         String   // e.g. "trial_welcome", "referral_reward_earned"
  dedupeKey         String   @unique
  toEmail           String
  subject           String?

  status            String   @default("sent") // "sent" | "failed" | "skipped"
  providerMessageId String?  // Resend's message id, when the send succeeded
  errorMessage      String?  // message only, never a full provider error object

  sentAt            DateTime @default(now())

  @@index([userId, emailType])
  @@index([emailType, sentAt])
}

// The 5-minute feedback survey that earns exactly one +14 day trial
// extension. userId is @unique: that constraint - not application logic - is
// what makes the extension unrepeatable, so concurrent double-submits can't
// both succeed. Testimonials are deliberately NOT collected here; a
// testimonial is a separate, later, entirely optional ask (see
// src/lib/email/lifecycle.ts) and is never a condition of the extension.
model TrialFeedback {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mostValuable   String   @db.Text
  confusing      String   @db.Text
  wishItShowed   String   @db.Text
  worthPayingFor String   @db.Text
  anythingElse   String?  @db.Text

  // Recorded on the row rather than assumed, so the admin view can show
  // exactly what each account was granted even if the policy changes later.
  daysGranted    Int      @default(14)
  newTrialEndsAt DateTime

  createdAt      DateTime @default(now())
}

// A referral code belongs to EITHER a customer (free-month program) or a
// partner firm (recurring commission program) - never both. Both kinds share
// one code space and one /r/[code] landing route so attribution has a single
// code path; `kind` decides which reward system the resulting Referral runs
// through.
model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique // short, unambiguous, case-insensitive (stored uppercase)
  kind      String   // "customer" | "partner"

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  partnerId String?  @unique
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  referrals Referral[]

  @@index([kind])
}

// One row per referred account. `referredUserId` is @unique, which is the
// core anti-fraud constraint: a given JobProfitAI account can be attributed
// to exactly one referrer, ever, no matter how many referral links it
// touches. Self-referral is rejected at attribution time (see
// src/lib/referrals.ts).
model Referral {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  kind           String       // "customer" | "partner" - copied from the code at attribution time

  referrerUserId String?
  referrer       User?        @relation("ReferrerUser", fields: [referrerUserId], references: [id], onDelete: SetNull)

  partnerId      String?
  partner        Partner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // Nullable + SetNull rather than Cascade, deliberately. If a referred
  // contractor deletes their JobProfitAI account, the Referral row (and the
  // PartnerCommission rows hanging off it) must SURVIVE - otherwise deleting
  // a client account would silently erase a partner's earned, possibly
  // unpaid, commission history. The account goes; the financial record of
  // what was earned stays. Postgres allows multiple NULLs under a unique
  // constraint, so "one referral per referred account" is still enforced for
  // every live account.
  referredUserId String?      @unique
  referredUser   User?        @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  // "signed_up" -> "paid" (first invoice paid) -> "qualified" (customer
  // program only: 30 days paid, no refund/chargeback). "disqualified" is
  // terminal and set on refund/chargeback/fraud.
  status             String    @default("signed_up")
  signedUpAt         DateTime  @default(now())
  firstPaidAt        DateTime?
  qualifiedAt        DateTime?
  disqualifiedAt     DateTime?
  disqualifiedReason String?

  reward         ReferralReward?
  commissions    PartnerCommission[]

  @@index([referrerUserId, status])
  @@index([partnerId, status])
  @@index([status])
}

// Customer program reward: one free month of the referrer's CURRENT plan,
// issued as a Stripe customer balance credit so it automatically reduces the
// next invoice(s). `referralId` is @unique - one reward per qualifying
// referral, enforced by the database rather than by a code path that a
// webhook retry could run twice.
model ReferralReward {
  id             String   @id @default(cuid())
  referralId     String   @unique
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  referrerUserId String
  referrer       User     @relation(fields: [referrerUserId], references: [id], onDelete: Cascade)

  // Amount is resolved from the referrer's active base plan at the moment
  // the reward qualifies ($149 plan -> 14900, $299 plan -> 29900), then
  // frozen here. A later plan change never retroactively re-prices an
  // already-earned reward.
  amountCents    Int
  plan           String

  status         String   @default("pending") // "pending" | "applied" | "voided"

  // Stripe's customer balance transaction id, set once the credit is
  // actually on the customer's balance. Null while pending (e.g. the
  // referrer has no Stripe customer yet because they're still on trial).
  stripeBalanceTxnId String? @unique

  earnedAt       DateTime @default(now())
  appliedAt      DateTime?
  voidedAt       DateTime?
  voidReason     String?

  @@index([referrerUserId, status])
}

// An accounting/bookkeeping firm in the partner program. Deliberately a
// separate entity from the customer referral program: partners earn a
// recurring percentage commission, not free months.
//
// SECURITY: a Partner row grants NO access whatsoever to any referred
// contractor's QuickBooks or financial data. Partner status and data access
// are entirely unrelated systems - a contractor must explicitly invite an
// accountant through normal account access controls for that. Nothing in
// this model or the partner dashboard reads another account's financials.
model Partner {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firmName            String
  contactName         String
  phone               String?
  website             String?
  clientCountEstimate String?   // free text from the application form

  status              String    @default("pending") // "pending" | "approved" | "rejected" | "suspended"
  approvedAt          DateTime?
  rejectedAt          DateTime?

  // Around 3 active paying clients a partner qualifies for a complimentary
  // JobProfitAI account for their own firm. Recorded here when granted.
  freeAccountGrantedAt DateTime?

  // Where commissions get paid. Payouts are an admin-run ledger workflow
  // today (no Stripe Connect yet) - see PartnerCommission.status and
  // PRODUCTION_CUTOVER.md. Kept as plain contact detail, never bank details.
  payoutEmail         String?
  adminNotes          String?   @db.Text

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  referralCode        ReferralCode?
  referrals           Referral[]
  commissions         PartnerCommission[]

  @@index([status])
}

// One row per commissionable paid invoice. `stripeInvoiceId` is @unique
// across the whole table, so a Stripe webhook retry - or two concurrent
// deliveries of the same invoice.paid event - can never produce two
// commissions for one payment.
model PartnerCommission {
  id             String   @id @default(cuid())
  partnerId      String
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  referralId     String
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referredUserId String

  stripeInvoiceId      String  @unique
  stripeSubscriptionId String?
  stripeCustomerId     String?

  // Subscription line revenue only - tax is excluded before this is stored
  // (see src/lib/partners.ts), so commission is never paid on sales tax.
  subscriptionRevenueCents Int
  // Basis points (2000 = 20%, 2500 = 25%, 3000 = 30%), frozen at the rate
  // that applied when this invoice was paid. A later tier upgrade changes
  // the rate on SUBSEQUENT invoices only - it never retroactively re-prices
  // commissions already earned.
  commissionRateBps        Int
  commissionCents          Int

  // 1-12. Commission eligibility ends after the 12th successfully paid
  // subscription month for this referred customer.
  monthNumber    Int

  status         String   @default("earned") // "earned" | "paid" | "voided"
  earnedAt       DateTime @default(now())
  paidAt         DateTime?
  paidNote       String?
  voidedAt       DateTime?
  voidReason     String?

  @@index([partnerId, status])
  @@index([referralId])
}

// Marketing-site contact form submissions. Stored as well as emailed, so a
// Resend outage never loses a sales lead - the email send result is recorded
// on the row itself (emailDeliveredAt / emailError) so an admin can spot and
// re-send anything that failed.
model ContactSubmission {
  id               String    @id @default(cuid())
  name             String
  company          String?
  email            String
  phone            String?
  reason           String
  message          String    @db.Text

  // Hashed, never the raw IP - used only for rate limiting and abuse review.
  ipHash           String?
  userAgent        String?

  emailDeliveredAt DateTime?
  emailError       String?

  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([reason])
}
