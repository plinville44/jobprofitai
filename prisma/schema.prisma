// JobMarginAI data model
// Core idea: a User owns one or more QuickBooksConnections (one per QBO company file).
// Each connection syncs Jobs, which accumulate CostEntries and Estimates.
// A WeeklyDigest is generated per connection per week from that data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connections   QuickBooksConnection[]
  subscription  Subscription?
}

// One per connected QuickBooks Online company file ("realm").
// A user could plausibly run this for more than one company (e.g. an accountant),
// so this is 1-to-many rather than 1-to-1.
model QuickBooksConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The QuickBooks company ("realm") ID, encrypted at rest (AES-256-GCM,
  // see src/lib/crypto.ts) per Intuit's security requirements. Since the
  // encrypted value isn't queryable (random IV each time), realmIdHash - a
  // deterministic SHA-256 hash - is what "which company is this" lookups
  // actually use. Decrypt `realmId` only when the real ID is needed (e.g.
  // to call the QuickBooks API).
  realmId           String    @db.Text
  realmIdHash       String    @unique
  companyName       String?

  // OAuth tokens - encrypted at the application layer before write, see src/lib/crypto.ts
  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  accessTokenExpiresAt   DateTime
  refreshTokenExpiresAt  DateTime

  environment       String    @default("sandbox") // "sandbox" | "production"
  costTrackingMode  String    @default("unknown")  // "projects" | "classes" | "unknown" - discovered on first sync

  // Company-wide default target job margin (%). Per-category overrides live in
  // MarginTarget below; this is the fallback when no category-specific target
  // exists. Nullable until the user sets one in Settings - no target means
  // "below target" comparisons simply don't run yet.
  targetMarginPct   Decimal?  @db.Decimal(5, 2)

  // Overhead allocation (powers "Fully Loaded Profit" - off by default per spec;
  // Fully Loaded Profit is only ever computed/shown when overheadEnabled=true
  // AND overheadMethod/overheadValue are both set).
  overheadEnabled   Boolean   @default(false)
  overheadMethod    String?   // "pct_of_revenue" | "pct_of_direct_cost"
  overheadValue     Decimal?  @db.Decimal(7, 4)

  // Weekly email preferences. Defaults to Monday 8am in the connection owner's
  // timezone per spec, until they configure otherwise in Settings.
  emailEnabled      Boolean   @default(true)
  emailRecipients   String[]  @default([])
  emailDay          Int       @default(1) // 0=Sun..6=Sat
  emailHour         Int       @default(8) // 0-23, local to emailTimezone
  emailTimezone     String    @default("America/New_York")

  // Sync observability (see also the SyncRun history table below - these are
  // just "latest" fields for fast dashboard reads without a join).
  lastSyncStatus            String?   // "success" | "error" | "in_progress"
  lastSyncError             String?
  lastSyncAttemptAt         DateTime?
  lastSyncEntitiesUpdated   Json?
  lastFullSyncAt            DateTime? // last time a full (non-incremental) sync ran

  connectedAt       DateTime  @default(now())
  disconnectedAt    DateTime?
  lastSyncedAt      DateTime?

  jobs              Job[]
  digests           WeeklyDigest[]
  marginTargets     MarginTarget[]
  syncRuns          SyncRun[]
  analysisRuns      AnalysisRun[]
  profitInsights    ProfitInsight[]
  feedback          Feedback[]

  @@index([userId])
}

// Per-category override of the connection's default target margin (e.g.
// "roofing jobs should target 22%, everything else uses the company default").
// category = null is reserved/unused here - the connection-wide default lives
// on QuickBooksConnection.targetMarginPct directly, not as a row here, to avoid
// a chicken-and-egg lookup on every request.
model MarginTarget {
  id            String    @id @default(cuid())
  connectionId  String
  connection    QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  category      String
  targetPct     Decimal   @db.Decimal(5, 2)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([connectionId, category])
  @@index([connectionId])
}

// History of sync attempts, for the observability the App Assessment
// Questionnaire and the product spec both ask for (last attempted/successful
// sync, status, errors, entities updated) - not just a "last synced at"
// snapshot, an actual log to look back on if something goes wrong.
model SyncRun {
  id                String    @id @default(cuid())
  connectionId      String
  connection        QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  status            String    // "in_progress" | "success" | "error"
  mode              String    // "full" | "incremental"
  entitiesUpdated   Json?     // e.g. { jobs: 3, purchases: 12, bills: 4, timeActivities: 9, invoices: 8, estimates: 2 }
  errorMessage      String?

  @@index([connectionId])
}

// One row per time the dashboard/intelligence numbers were (re)computed.
// Used to answer "has financial data changed since the last analysis" by
// comparing dataSnapshotAt to the connection's current lastSyncedAt, so
// /api/analysis/refresh doesn't re-run the AI layer unless something actually
// changed.
model AnalysisRun {
  id              String    @id @default(cuid())
  connectionId    String
  connection      QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  generatedAt     DateTime  @default(now())
  dataSnapshotAt  DateTime  // the connection.lastSyncedAt this analysis was computed from
  kind            String    // "dashboard" | "intelligence"

  @@index([connectionId, kind])
}

// A persisted Profit Intelligence finding (Finding/Evidence/Impact/Action/
// Confidence). sourceJobIds makes every finding traceable back to the jobs
// that produced it, per the "why am I seeing this" explainability requirement.
// confidence is assigned deterministically by app code before storage (based
// on sample size), never by the model's own self-assessment.
model ProfitInsight {
  id                String    @id @default(cuid())
  connectionId      String
  connection        QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  generatedAt       DateTime  @default(now())
  dimension         String    // "job_category" | "customer" | "cost_category" | ...
  finding           String    @db.Text
  evidence          String    @db.Text
  financialImpact   Decimal?  @db.Decimal(12, 2)
  recommendedAction String    @db.Text
  confidence        String    // "high" | "medium" | "low"
  status            String    @default("active") // "active" | "dismissed"
  sourceJobIds      String[]  @default([])

  @@index([connectionId, status])
}

// "Suggest an Improvement" submissions. Stored first (always succeeds even if
// the notification email fails) - the spec is explicit that feedback must not
// depend on email alone.
model Feedback {
  id            String    @id @default(cuid())
  userId        String
  userEmail     String
  connectionId  String?
  connection    QuickBooksConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  plan          String

  category      String    // "Feature Request" | "Report" | "Integration" | "Bug/Problem" | "Other"
  message       String    @db.Text
  page          String
  screenshotUrl String?   // not wired up yet - see plan's known-limitations note (needs blob storage)

  createdAt     DateTime  @default(now())

  @@index([userId])
}

// A "job" maps to a QuickBooks Project (sub-customer) or a Class, depending on
// how the contractor tracks cost. We normalize both into this one model.
model Job {
  id                String    @id @default(cuid())
  connectionId      String
  connection        QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  qboId             String    // QBO Project/Customer/Class ID
  // The parent Customer's QBO id, when this Job is a Project (sub-customer).
  // Captured so expenses tagged to the parent customer instead of the project
  // itself - common when a bookkeeper enters a Bill/Purchase without drilling
  // into the specific Project - can still be attributed to this job when
  // it's the parent's only job. See CostEntry.attributionMethod.
  parentQboId       String?
  name              String
  customerName      String?
  status            String    @default("open") // "open" | "closed"

  estimatedRevenue  Decimal?  @db.Decimal(12, 2) // synced from QBO Estimate entity when available
  estimatedCost     Decimal?  @db.Decimal(12, 2) // manual only - QBO's public API doesn't expose internal cost budgets, see plan §6
  estimatedCostSource String  @default("manual")  // always "manual" today; field exists so the UI/tooltips are honest about provenance rather than implying it came from QuickBooks

  // Manually-set job type (e.g. "roofing", "remodel"), used for cross-job
  // benchmarking in Profit Intelligence. QBO has no reliable field for this
  // (see plan §6) so it's a simple optional in-app tag, not synced.
  category          String?

  startDate         DateTime?
  endDate           DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  costEntries       CostEntry[]
  invoices          InvoiceSummary[]

  @@unique([connectionId, qboId])
  @@index([connectionId])
}

// Raw actual-cost line items pulled from QBO: bills, expenses, time activities,
// purchase orders. Kept granular so the profitability engine can break down by category.
model CostEntry {
  id            String    @id @default(cuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  qboSourceType String    // "Bill" | "Expense" | "TimeActivity" | "Purchase"
  qboSourceId   String

  category      String    // "labor" | "materials" | "subcontractor" | "equipment" | "overhead" | "other"
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  txnDate       DateTime

  // "direct" = the transaction's own CustomerRef matched this job's QBO id
  // exactly. "parent_customer_fallback" = the transaction was tagged to this
  // job's PARENT customer instead of the job/project itself, and this was
  // the parent's only job, so it was attributed here - a judgment call worth
  // being able to spot and double-check, not a fabricated number (the dollar
  // amount is always the real transaction amount either way).
  attributionMethod String @default("direct")

  createdAt     DateTime  @default(now())

  @@index([jobId])
  @@index([jobId, category])
}

// Actual revenue recognized against a job, from QBO invoices.
model InvoiceSummary {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  qboInvoiceId String
  amount       Decimal  @db.Decimal(12, 2)
  status       String   // "paid" | "open" | "overdue"
  txnDate      DateTime

  @@index([jobId])
}

// One generated digest per connection per week. `metrics` holds the computed
// profitability numbers (see src/lib/profitability.ts); `narrative` is the
// AI-written summary built strictly from `metrics` (see src/lib/digest.ts).
model WeeklyDigest {
  id             String    @id @default(cuid())
  connectionId   String
  connection     QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  weekStarting   DateTime
  metrics        Json      // structured profitability data the narrative is grounded in
  narrative      String    @db.Text
  // "narrative" = Claude-written digest (normal case). "data_health" = the
  // AI narrative was skipped entirely and `narrative` holds a deterministic,
  // plain-text explanation of what's missing instead - used when company-wide
  // Data Confidence is too low to trust an AI-written take on profitability
  // (see src/lib/digest.ts). Never AI-written when kind = "data_health".
  kind           String    @default("narrative")
  emailedAt      DateTime?

  createdAt      DateTime  @default(now())

  @@unique([connectionId, weekStarting])
  @@index([connectionId])
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  status                String    @default("trialing") // "trialing" | "active" | "past_due" | "canceled"

  // Entitlement tier - read exclusively through src/lib/entitlements.ts, never
  // checked directly elsewhere in the app. Defaults to full Profit Intelligence
  // access for now since Stripe billing isn't wired up yet (Preston's explicit
  // beta decision, 2026-08-14) - flipping this default to "profit_monitor" (or
  // null/no-plan) the day billing goes live is a one-line change here, not a
  // rearchitecture.
  plan                  String    @default("profit_intelligence") // "profit_monitor" | "profit_intelligence"
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?

  createdAt             DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
